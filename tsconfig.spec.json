{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    // process.env.CI is an index-signature property; the base config forbids dot access to those.
    "noPropertyAccessFromIndexSignature": false
  },
  "include": ["playwright.config.ts", "e2e/**/*.ts"]
}